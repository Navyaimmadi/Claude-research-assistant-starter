# Ask your course provider for these values. Never commit your real key.
SHARED_LLM_API_KEY=replace_with_shared_llm_key
SHARED_LLM_BASE_URL=https://replace-with-course-endpoint/v1
# Run npm run probe, then set to anthropic or openai. Do not leave auto for normal runs.
SHARED_LLM_PROTOCOL=auto
# Defaults to kimi-k2.7-code when omitted.
MODEL_NAME=kimi-k2.7-code

# Pricing in USD per million tokens. Use the shared provider's actual rates.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
CACHE_WRITE_PRICE_PER_MILLION=
CACHE_READ_PRICE_PER_MILLION=

# Extended thinking is required by the brief. The selected model/endpoint must support it.
THINKING_BUDGET_TOKENS=2048
MAX_OUTPUT_TOKENS=4096
MAX_AGENT_TURNS=8
